as.character(mean( (1+dfParamsPropsAbcPass $ssd)/(1+dfParamsPropsAbcPass$swd)))))
print(paste0("CI95 ",
as.character(quantile( (1+dfParamsPropsAbcPass $ssd)/(1+dfParamsPropsAbcPass$swd),
c(0.025,.975)))))
